{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osrs-tcg-foils/schema/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "cardName": {
      "description": "Exact name as it appears in src/data/cards.json. Case sensitive.",
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "decisionId": {
      "description": "Entry id in docs/decisions.md.",
      "type": "string",
      "pattern": "^DEC-\\d{4}$"
    },
    "action": {
      "description": "Closed verb vocabulary. See docs/rules-spec.md section 4.",
      "enum": [
        "wear",
        "wield",
        "use",
        "mine",
        "chop",
        "catch",
        "plant",
        "smelt",
        "smith",
        "cook",
        "craft",
        "fletch"
      ]
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" },
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence": {
      "enum": ["sourced", "contested", "undecided"]
    },
    "ruleConfidence": {
      "description": "A rule entry may never declare 'undecided' - that state belongs to 'unresolved' alone.",
      "enum": ["sourced", "contested"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": {
          "enum": ["brief", "decision", "community", "wiki", "game-data"]
        },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "decision": { "$ref": "#/$defs/decisionId" },
        "quote": { "type": "string", "minLength": 1 },
        "retrieved": { "$ref": "#/$defs/date" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "decision" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["decision"],
            "properties": { "decision": true }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["community", "wiki"] } },
            "required": ["kind"]
          },
          "then": {
            "required": ["url"],
            "properties": { "url": true }
          }
        }
      ]
    },
    "sources": {
      "description": "Mandatory. An entry with no source is a schema error, not a judgement call.",
      "type": "array",
      "items": { "$ref": "#/$defs/source" },
      "minItems": 1
    },
    "caveats": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rulesetCaveats": {
      "description": "Caveats attached only under the named ruleset, merged on top of the global ruleset caveats.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standard": { "$ref": "#/$defs/caveats" },
        "extreme": { "$ref": "#/$defs/caveats" }
      }
    },
    "member": {
      "description": "A card in a family. Bare string is shorthand for { card: <string> }.",
      "oneOf": [
        { "$ref": "#/$defs/cardName" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["card"],
          "properties": {
            "card": { "$ref": "#/$defs/cardName" },
            "cosmeticOf": {
              "description": "This card is a stat-identical reskin of the named card. Factual marker only - it does not by itself decide rung placement. See DEC-0003.",
              "$ref": "#/$defs/cardName"
            },
            "actions": {
              "description": "Overrides the family action set for this member only.",
              "$ref": "#/$defs/actions"
            },
            "produces": {
              "description": "Card this member turns into under a transformation action. Used to name the product in the verb-not-product caveat.",
              "$ref": "#/$defs/cardName"
            },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "members": {
      "type": "array",
      "items": { "$ref": "#/$defs/member" },
      "minItems": 1
    }
  }
}
